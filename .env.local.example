# Bu dosya bir ŞABLONDUR — içinde gerçek değer yoktur, depoda durması güvenlidir.
#
# Değerleri nereden alacaksın:
#   Firebase Console → ⚙ Project settings → General
#   → aşağı kaydır → "Your apps" → web uygulaman → "SDK setup and configuration"
#   → "Config" seçeneği. Ekranda şuna benzer bir blok görürsün:
#
#     const firebaseConfig = {
#       apiKey: "AIzaSyD-ornek-anahtar",
#       authDomain: "shiftorbit.firebaseapp.com",
#       projectId: "shiftorbit",
#       storageBucket: "shiftorbit.appspot.com",
#       messagingSenderId: "123456789012",
#       appId: "1:123456789012:web:abc123def456"
#     };
#
#   Oradaki her değeri aşağıdaki karşılığına TIRNAKSIZ olarak yapıştır.
#
# Yerelde çalıştırmak için : bu dosyayı ".env.local" adıyla kopyala ve doldur.
# Yayında (Vercel)         : aynı satırları Settings → Environment Variables'a ekle.

# apiKey            ↓
NEXT_PUBLIC_FIREBASE_API_KEY=
# authDomain        ↓
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# projectId         ↓
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# storageBucket     ↓
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# messagingSenderId ↓
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# appId             ↓
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sitenin kendi adresi. Paylaşım kartları ve canonical adresler bunu kullanır.
# Örn: https://shiftorbit.com   (sonunda eğik çizgi olmasın)
NEXT_PUBLIC_SITE_URL=
