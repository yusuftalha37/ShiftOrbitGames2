rules_version = '2';

// BAKIM MODU — tüm erişim kapalı.
// Eski kurallar firestore.rules.backup dosyasında yedeklendi.
// Siteyi tekrar açarken firestore.rules.backup içeriğini buraya geri kopyala.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
