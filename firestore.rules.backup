rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
//
// Signing up gives someone an account, not permission to change the site.
// Write access is limited to uids in `admins` that are not blocked. The
// first admin has to be created from the Firebase console; after that,
// admins can promote each other from the admin panel.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isBlocked() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get("blocked", false) == true;
    }

    function dayId() {
      return string(int(request.time.toMillis() / 86400000));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && !isBlocked();
    }

    // Public content: anyone can read, only admins can change.
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();

      // Yorum bırakmak için giriş yapılmış olmalı + engellenmiş olmamalı.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && !isBlocked()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 1000
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /team/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact messages: one per account per day.
    match /messages/{messageId} {
      allow get: if isAdmin()
        || (signedIn() && messageId == request.auth.uid + "_" + dayId());
      allow list: if isAdmin();

      allow create: if signedIn()
        && !isBlocked()
        && messageId == request.auth.uid + "_" + dayId()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && !("blocked" in request.resource.data);
      allow update: if isAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(["email", "displayName", "lastSeenAt"]));
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
